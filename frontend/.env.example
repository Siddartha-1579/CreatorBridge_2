# ==============================================================================
# CREATORBRIDGE — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# "Where Brands Meet Creativity"
# 
# Copy to '.env' inside the /frontend directory for local development:
#   cp .env.example .env
#
# CRITICAL SECURITY NOTE:
# ALL variables prefixed with 'VITE_' are bundled and exposed to the browser.
# NEVER place private API keys, service role keys, or secrets in this file.
# ==============================================================================

# Backend API URL (Proxied via Vite or direct endpoint)
VITE_API_URL="/api/v1"

# Supabase Public Configuration (Safe for frontend exposure)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"          # Legacy alias for backward compatibility

# Cloudflare Turnstile Public Site Key
# Test site key: 1x00000000000000000000AA (always passes in development)
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA" # Legacy alias

# Optional Stripe Publishable Key (Safe for frontend checkout widgets)
VITE_STRIPE_PUBLISHABLE_KEY=""

# Application Environment Mode
VITE_APP_ENV="development"
