# ==============================================================================
# CREATORBRIDGE — CENTRALIZED ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# "Where Brands Meet Creativity"
# 
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development:
#    cp .env.example .env
# 2. Populate API keys one by one as integrations are activated.
# 3. NEVER commit real credentials, API secrets, or private keys to Git.
# 4. In production environments (Vercel, Cloudflare, Render, AWS, Docker),
#    configure these environment variables in your deployment dashboard.
# ==============================================================================

# ==============================================================================
# SECTION 1: CORE APPLICATION & SERVER SETTINGS
# ==============================================================================
APP_NAME="CreatorBridge AI Creator Marketplace"
APP_ENV="development"                                 # Options: development, staging, production
APP_DEBUG=true                                        # Set false in production
APP_VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"                                      # Options: DEBUG, INFO, WARNING, ERROR

# Rate Limiting Guardrails (Requests per minute)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=60
ENABLE_SECURITY_HEADERS=true

# ==============================================================================
# SECTION 2: SUPABASE — AUTHENTICATION, DATABASE & STORAGE (A)
# ==============================================================================
# Project Dashboard: https://supabase.com/dashboard/project/_/settings/api
# Used for PostgreSQL persistence, JWT auth verification, and file storage.

# Server-Side Variables:
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY=""                                # Secret service-role key (privileged, server-side only)
SUPABASE_SERVICE_ROLE_KEY=""                          # Legacy alias for SUPABASE_SECRET_KEY
SUPABASE_ANON_KEY="your-anon-public-key"              # Client-safe anon key for token verification
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"        # Project JWT Secret for offline verification

# Object Storage Bucket Names:
STORAGE_PORTFOLIOS_BUCKET="portfolios"
STORAGE_GENERATIONS_BUCKET="generated-assets"
STORAGE_PROJECTS_BUCKET="project-files"
STORAGE_AVATARS_BUCKET="avatars"

# Frontend-Safe Supabase Variables (Public browser bundle):
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"  # Modern publishable key
VITE_SUPABASE_ANON_KEY="your-anon-public-key"          # Legacy alias for VITE_SUPABASE_PUBLISHABLE_KEY

# ==============================================================================
# SECTION 3: OPENAI — CORE AI ENGINE (B)
# ==============================================================================
# Developer Portal: https://platform.openai.com/api-keys
# Powers: Adaptive onboarding, creator profiling, brand brief builder,
# intelligent matching explanations, policy moderation, image generation, and TTS fallback.

OPENAI_API_KEY=""                                     # Primary OpenAI Secret Key (sk-proj-...)
OPENAI_MODEL="gpt-4o-mini"                            # Primary text reasoning model (gpt-4o, gpt-4o-mini)
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"       # Semantic matching vector model (1536 dims)
EMBEDDING_MODEL="text-embedding-3-small"              # Legacy alias for OPENAI_EMBEDDING_MODEL

# Operational AI Guardrails
AI_PROVIDER="openai"                                  # Active primary AI provider: openai, anthropic
AI_REQUEST_TIMEOUT_SECONDS=30                         # Per-request timeout
AI_MAX_RETRIES=3                                      # Exponential backoff retry limit
AI_MAX_INPUT_CHARS=12000                              # Prompt character ceiling

# Optional Anthropic Claude Alternative
ANTHROPIC_API_KEY=""                                 # Claude Secret Key (sk-ant-...)
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ==============================================================================
# SECTION 4: CLOUDFLARE TURNSTILE — BOT & FRAUD PROTECTION (C)
# ==============================================================================
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Official Test Keys (Always passes in development mode):
#   Site Key:   1x00000000000000000000AA
#   Secret Key: 1x0000000000000000000000000000000AA

# Frontend Public Widget Key:
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA" # Legacy alias

# Backend Server Verification Secret:
CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
CLOUDFLARE_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_VERIFY_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"

# ==============================================================================
# SECTION 5: AI IMAGE GENERATION (D)
# ==============================================================================
# By default, uses OPENAI_API_KEY above with DALL-E 3.
# Optional dedicated providers can be configured when selected.

OPENAI_IMAGE_MODEL="dall-e-3"                         # Default DALL-E 3 model
IMAGE_PROVIDER="openai"                               # Options: openai, stability, fal
IMAGE_API_KEY=""                                      # Dedicated key (optional; defaults to OPENAI_API_KEY)
IMAGE_MODEL="dall-e-3"

# Optional Alternative Providers
STABILITY_API_KEY=""                                  # Stability AI Key
FAL_AI_API_KEY=""                                     # Fal.ai Key (FLUX.1 Pro fast generation)

# ==============================================================================
# SECTION 6: AI VIDEO GENERATION (E)
# ==============================================================================
# Generic video provider configuration. Compatible with Runway, Luma, Kling, etc.
# Remains in unconfigured status until provider is chosen and key provided.

VIDEO_AI_API_KEY=""                                   # Video Provider API Key
VIDEO_AI_BASE_URL=""                                  # Custom endpoint (leave blank for default)
VIDEO_AI_MODEL="gen3a_turbo"                          # e.g., gen3a_turbo, dream-machine
VIDEO_PROVIDER="runway"
RUNWAY_API_KEY=""                                     # Legacy alias for VIDEO_AI_API_KEY
VIDEO_MODEL="gen3a_turbo"

# ==============================================================================
# SECTION 7: AI VOICEOVER & TEXT-TO-SPEECH (F)
# ==============================================================================
# Generic TTS provider configuration. Adapts to OpenAI or ElevenLabs.

TTS_API_KEY=""                                        # Dedicated Voice API Key (or defaults to OPENAI_API_KEY)
TTS_BASE_URL=""                                       # Custom endpoint (leave blank for default)
TTS_MODEL="tts-1"                                     # e.g., tts-1, tts-1-hd, eleven_multilingual_v2
VOICE_PROVIDER="openai"                               # Options: openai, elevenlabs
VOICE_API_KEY=""                                      # Legacy alias
ELEVENLABS_API_KEY=""                                 # ElevenLabs API Key (optional)
VOICE_MODEL="tts-1"

# ==============================================================================
# SECTION 8: OPTIONAL AUDIO TRANSCRIPTION (G)
# ==============================================================================
# Speech-to-text transcription (e.g., Whisper). Reuses OPENAI_API_KEY if not specified.

TRANSCRIPTION_API_KEY=""                              # Dedicated Transcription Key (optional)
TRANSCRIPTION_MODEL="whisper-1"                       # Default Whisper model

# ==============================================================================
# SECTION 9: EMAIL & NOTIFICATIONS (H)
# ==============================================================================
# Resend API: https://resend.com/api-keys
# Remains disabled until key and verified sender address are provided.

RESEND_API_KEY=""                                     # Resend API Key (re_...)
EMAIL_FROM="notifications@creatorbridge.com"          # Verified sender email address

# ==============================================================================
# SECTION 10: PAYMENTS & COMMERCIAL ESCROW (I)
# ==============================================================================
# Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Used for brand campaign milestone funding, creator escrow, and payouts.

STRIPE_SECRET_KEY=""                                  # Stripe Secret Key (sk_test_... or sk_live_...)
STRIPE_PUBLISHABLE_KEY=""                             # Stripe Publishable Key (pk_test_... or pk_live_...)
STRIPE_WEBHOOK_SECRET=""                              # Stripe Webhook Signing Secret (whsec_...)
VITE_STRIPE_PUBLISHABLE_KEY=""                        # Frontend safe Stripe publishable key

# ==============================================================================
# SECTION 11: FRONTEND CLIENT VARIABLES (Vite bundle safe only)
# ==============================================================================
# WARNING: All VITE_* variables are exposed to the browser.
# NEVER place API secrets, service-role keys, or private tokens here.

VITE_API_URL="/api/v1"
VITE_APP_ENV="development"
