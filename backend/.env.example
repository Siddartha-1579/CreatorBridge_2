# ==============================================================================
# CREATORBRIDGE — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# "Where Brands Meet Creativity"
# 
# Copy to '.env' inside the /backend directory for local execution:
#   cp .env.example .env
# ==============================================================================

# --- APPLICATION & SERVER ---
APP_NAME="CreatorBridge AI Creator Marketplace"
APP_ENV="development"
APP_DEBUG=true
APP_VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# --- RATE LIMITING GUARDRAILS ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=60
ENABLE_SECURITY_HEADERS=true

# --- SUPABASE DATABASE & AUTH (SERVER-SIDE) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY=""                                # Recommended modern secret key
SUPABASE_SERVICE_ROLE_KEY=""                          # Backward-compatible legacy alias
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# --- SUPABASE OBJECT STORAGE BUCKETS ---
STORAGE_PORTFOLIOS_BUCKET="portfolios"
STORAGE_GENERATIONS_BUCKET="generated-assets"
STORAGE_PROJECTS_BUCKET="project-files"
STORAGE_AVATARS_BUCKET="avatars"

# --- CLOUDFLARE TURNSTILE (SERVER-SIDE VERIFICATION) ---
CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
CLOUDFLARE_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_VERIFY_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"

# --- OPENAI & CORE AI REASONING (REQUIRED FOR AI FEATURES) ---
OPENAI_API_KEY=""                                     # sk-proj-...
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_MODEL="text-embedding-3-small"              # Legacy alias
AI_PROVIDER="openai"
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_MAX_INPUT_CHARS=12000

# Optional Alternative: Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# --- AI IMAGE GENERATION (REUSES OPENAI_API_KEY BY DEFAULT) ---
OPENAI_IMAGE_MODEL="dall-e-3"
IMAGE_PROVIDER="openai"
IMAGE_API_KEY=""                                      # Leave empty to reuse OPENAI_API_KEY
IMAGE_MODEL="dall-e-3"
STABILITY_API_KEY=""
FAL_AI_API_KEY=""

# --- AI VIDEO GENERATION ---
VIDEO_AI_API_KEY=""
VIDEO_AI_BASE_URL=""
VIDEO_AI_MODEL="gen3a_turbo"
VIDEO_PROVIDER="runway"
RUNWAY_API_KEY=""                                     # Legacy alias

# --- AI VOICEOVER & TEXT-TO-SPEECH ---
TTS_API_KEY=""                                        # Leave empty to reuse OPENAI_API_KEY
TTS_BASE_URL=""
TTS_MODEL="tts-1"
VOICE_PROVIDER="openai"
VOICE_API_KEY=""                                      # Legacy alias
ELEVENLABS_API_KEY=""                                 # Optional dedicated ElevenLabs key

# --- OPTIONAL TRANSCRIPTION ---
TRANSCRIPTION_API_KEY=""                              # Leave empty to reuse OPENAI_API_KEY
TRANSCRIPTION_MODEL="whisper-1"

# --- EMAIL NOTIFICATIONS (OPTIONAL) ---
RESEND_API_KEY=""
EMAIL_FROM="notifications@creatorbridge.com"

# --- PAYMENTS & ESCROW (OPTIONAL) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
